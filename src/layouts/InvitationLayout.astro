---
import '../styles/global.css';
import '../styles/animations.css';
import '../styles/invitation.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/assets/couple/og-preview.jpg" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph for WhatsApp & Social Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta name="theme-color" content="#FAF7F2" />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💌</text></svg>" />
  </head>
  <body>
    <!-- Decorative Floating Watercolor Corner Florals -->
    <div class="floral-corner floral-tl">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,0 C30,10 60,40 70,80 C60,60 40,40 0,0" fill="#E8C5C8" opacity="0.6"/>
        <path d="M0,0 C15,35 35,65 80,70 C50,55 25,35 0,0" fill="#8A9A86" opacity="0.5"/>
        <circle cx="28" cy="28" r="8" fill="#B88E44" opacity="0.35"/>
      </svg>
    </div>

    <div class="floral-corner floral-br">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(180deg);">
        <path d="M0,0 C30,10 60,40 70,80 C60,60 40,40 0,0" fill="#E8C5C8" opacity="0.6"/>
        <path d="M0,0 C15,35 35,65 80,70 C50,55 25,35 0,0" fill="#8A9A86" opacity="0.5"/>
        <circle cx="28" cy="28" r="8" fill="#B88E44" opacity="0.35"/>
      </svg>
    </div>

    <slot />
  </body>
</html>

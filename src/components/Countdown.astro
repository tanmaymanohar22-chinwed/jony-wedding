---
interface Props {
  weddingDate?: string;
}

const { weddingDate = "2026-12-29T16:00:00+05:30" } = Astro.props;

// Calculate exact initial digits on load so there are zero placeholder dashes
const targetEpoch = Date.parse(weddingDate);
const initialDiff = Math.max(0, targetEpoch - Date.now());
const initialDays = Math.floor(initialDiff / 86400000);
const initialHours = Math.floor((initialDiff % 86400000) / 3600000);
const initialMinutes = Math.floor((initialDiff % 3600000) / 60000);
const initialSeconds = Math.floor((initialDiff % 60000) / 1000);
---

<!-- Live Countdown Section (Clean, Seamless Circular Rings) -->
<section 
  id="countdown-section" 
  class="invite-section countdown-dormant reveal-on-scroll" 
  data-target-date={weddingDate}
  aria-label="Wedding Countdown"
  aria-hidden="true"
>
  <div class="countdown-container">
    <!-- Centered Circular Countdown Rings (Strictly 4 units, zero headings/subtitles) -->
    <div class="countdown-rings-grid" id="countdown-rings-container">
      <!-- DAYS (Muted Sage Green) -->
      <div class="countdown-circle-unit unit-days">
        <div class="circle-graphic-box">
          <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-bg" cx="50" cy="50" r="42" />
            <circle class="ring-meter" id="ring-days-meter" cx="50" cy="50" r="42" />
          </svg>
          <div class="circle-center-content">
            <span id="countdown-days" class="countdown-circle-num font-serif">{String(initialDays).padStart(2, "0")}</span>
          </div>
        </div>
        <span class="countdown-circle-label font-sans">DAYS</span>
      </div>

      <!-- HOURS (Soft Blush Pink) -->
      <div class="countdown-circle-unit unit-hours">
        <div class="circle-graphic-box">
          <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-bg" cx="50" cy="50" r="42" />
            <circle class="ring-meter" id="ring-hours-meter" cx="50" cy="50" r="42" />
          </svg>
          <div class="circle-center-content">
            <span id="countdown-hours" class="countdown-circle-num font-serif">{String(initialHours).padStart(2, "0")}</span>
          </div>
        </div>
        <span class="countdown-circle-label font-sans">HOURS</span>
      </div>

      <!-- MINUTES (Gentle Peach) -->
      <div class="countdown-circle-unit unit-mins">
        <div class="circle-graphic-box">
          <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-bg" cx="50" cy="50" r="42" />
            <circle class="ring-meter" id="ring-mins-meter" cx="50" cy="50" r="42" />
          </svg>
          <div class="circle-center-content">
            <span id="countdown-mins" class="countdown-circle-num font-serif">{String(initialMinutes).padStart(2, "0")}</span>
          </div>
        </div>
        <span class="countdown-circle-label font-sans">MINUTES</span>
      </div>

      <!-- SECONDS (Subtle Warm Champagne / Neutral) -->
      <div class="countdown-circle-unit unit-secs">
        <div class="circle-graphic-box">
          <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-bg" cx="50" cy="50" r="42" />
            <circle class="ring-meter" id="ring-secs-meter" cx="50" cy="50" r="42" />
          </svg>
          <div class="circle-center-content">
            <span id="countdown-secs" class="countdown-circle-num font-serif">{String(initialSeconds).padStart(2, "0")}</span>
          </div>
        </div>
        <span class="countdown-circle-label font-sans">SECONDS</span>
      </div>
    </div>
  </div>
</section>
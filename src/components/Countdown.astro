---
interface Props {
  weddingDate: string;
}

const { weddingDate } = Astro.props;
---

<!-- Live Countdown Section (Initially dormant and hidden until wedding-date-revealed event) -->
<section 
  id="countdown-section" 
  class="invite-section countdown-dormant" 
  data-target-date={weddingDate}
  aria-hidden="true"
>
  <div class="countdown-frame-wrapper">
    <!-- Decorative Rectangular Floral Frame -->
    <img 
      src="/jony-wedding/assets/decorations/countdown-floral-frame.jpg" 
      alt="Floral Watercolor Frame" 
      class="countdown-frame-art"
    />

    <!-- Centered Countdown Content -->
    <div class="countdown-inner-content">
      <span class="section-label">Awaiting The Holy Day</span>
      <h2 class="section-title" style="font-size: 1.85rem; margin-bottom: 2px;">Wedding Ceremony Countdown</h2>
      <p class="countdown-target-label">Tuesday, 29 December 2026 • 6:00 PM IST • Baptist Church Sanathnagar</p>
      
      <div id="countdown-container">
        <div class="countdown-grid">
          <div class="countdown-box">
            <span id="countdown-days" class="countdown-num">--</span>
            <span class="countdown-unit">Days</span>
          </div>
          <div class="countdown-box">
            <span id="countdown-hours" class="countdown-num">--</span>
            <span class="countdown-unit">Hours</span>
          </div>
          <div class="countdown-box">
            <span id="countdown-mins" class="countdown-num">--</span>
            <span class="countdown-unit">Mins</span>
          </div>
          <div class="countdown-box">
            <span id="countdown-secs" class="countdown-num">--</span>
            <span class="countdown-unit">Secs</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
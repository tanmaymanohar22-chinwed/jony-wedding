---
interface StoryData {
  title: string;
  subtitle: string;
  paragraphs: string[];
  quote: string;
}

interface Props {
  story: StoryData;
}

const { story } = Astro.props;
---

<section id="our-story" class="invite-section reveal-on-scroll">
  <div class="story-wrapper">
    <!-- Subtle Watercolor Landscape Background -->
    <img 
      src="/jony-wedding/assets/backgrounds/story-watercolor-bg.jpg" 
      alt="Watercolor Landscape" 
      class="story-bg-img"
    />

    <!-- Layered Stationery Paper Overlay -->
    <div class="story-card-overlay">
      <div class="section-heading-block" style="margin-bottom: 18px;">
        <span class="section-label">A JOURNEY OF LOVE</span>
        <h2 class="section-title">{story.title}</h2>
        <p class="section-desc">{story.subtitle}</p>
      </div>

      <div class="botanical-divider" style="margin: 0 auto 18px;">
        <span class="botanical-divider-icon">❦</span>
      </div>

      <div class="story-text-container">
        {story.paragraphs.map((para) => (
          <p class="story-paragraph">{para}</p>
        ))}

        {story.quote && (
          <div class="story-quote-block">
            <p>{story.quote}</p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
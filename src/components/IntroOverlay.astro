---
interface Props {
  monogram?: string;
  brideName?: string;
  groomName?: string;
  welcomeMessage?: string;
  formattedDate?: string;
  destination?: string;
}
---

<aside id="intro-overlay" class="intro-overlay burgundy-luxury-box" data-state="closed" aria-label="Wedding Invitation">
  <!-- Outer Full-Screen Deep Burgundy Presentation Box Frame -->
  <div class="burgundy-box-outer">
    <!-- Fine Antique Gold Ornamental Perimeter Border -->
    <div class="box-filigree-border" aria-hidden="true"></div>

    <!-- Central Warm-Ivory Stationery Panel -->
    <div class="ivory-stationery-panel" id="ivory-stationery-panel">
      <!-- Antique Gold Embossed Double Border -->
      <div class="ivory-panel-border" aria-hidden="true"></div>

      <!-- Ornamental Antique Gold Corner Filigree Accents -->
      <div class="ivory-corner-filigree corner-tl" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="36" height="36" fill="none">
          <path d="M4,36 L4,10 C4,6.7 6.7,4 10,4 L36,4" stroke="#C6A15B" stroke-width="1.8" />
          <path d="M10,28 L10,12 C10,10.9 10.9,10 12,10 L28,10" stroke="#D8BD88" stroke-width="1.2" />
          <circle cx="10" cy="10" r="2.5" fill="#C6A15B" />
          <path d="M16,4 Q24,14 36,14" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
          <path d="M4,16 Q14,24 14,36" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
        </svg>
      </div>
      <div class="ivory-corner-filigree corner-tr" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="36" height="36" fill="none">
          <path d="M4,4 L30,4 C33.3,4 36,6.7 36,10 L36,36" stroke="#C6A15B" stroke-width="1.8" />
          <path d="M12,10 L28,10 C29.1,10 30,10.9 30,12 L30,28" stroke="#D8BD88" stroke-width="1.2" />
          <circle cx="30" cy="10" r="2.5" fill="#C6A15B" />
          <path d="M24,4 Q16,14 4,14" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
          <path d="M36,16 Q26,24 26,36" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
        </svg>
      </div>
      <div class="ivory-corner-filigree corner-bl" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="36" height="36" fill="none">
          <path d="M4,4 L4,30 C4,33.3 6.7,36 10,36 L36,36" stroke="#C6A15B" stroke-width="1.8" />
          <path d="M10,12 L10,28 C10,29.1 10.9,30 12,30 L28,30" stroke="#D8BD88" stroke-width="1.2" />
          <circle cx="10" cy="30" r="2.5" fill="#C6A15B" />
          <path d="M16,36 Q24,26 36,26" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
          <path d="M4,24 Q14,16 14,4" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
        </svg>
      </div>
      <div class="ivory-corner-filigree corner-br" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="36" height="36" fill="none">
          <path d="M4,36 L30,36 C33.3,36 36,33.3 36,30 L36,4" stroke="#C6A15B" stroke-width="1.8" />
          <path d="M12,30 L28,30 C29.1,30 30,29.1 30,28 L30,12" stroke="#D8BD88" stroke-width="1.2" />
          <circle cx="30" cy="30" r="2.5" fill="#C6A15B" />
          <path d="M24,36 Q16,26 4,26" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
          <path d="M36,24 Q26,16 26,4" stroke="#C6A15B" stroke-width="0.8" opacity="0.7" />
        </svg>
      </div>

      <!-- Crossed Champagne-Gold Satin Ribbon Rig Wrapping Around Ivory Panel -->
      <div id="ribbon-rig" class="satin-ribbon-rig" aria-hidden="true">
        <!-- Vertical Satin Ribbon Band -->
        <div class="satin-strap satin-strap-vertical">
          <div class="satin-sheen"></div>
        </div>

        <!-- Horizontal Satin Ribbon Band -->
        <div class="satin-strap satin-strap-horizontal">
          <div class="satin-sheen"></div>
        </div>

        <!-- Central Tied Luxury Satin Bow -->
        <div class="satin-bow-rig">
          <svg class="satin-bow-svg" viewBox="0 0 240 220" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Champagne-Gold Satin Gradients -->
              <linearGradient id="satinGoldSheen" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFFDF7" />
                <stop offset="25%" stop-color="#F2E3C6" />
                <stop offset="55%" stop-color="#D8BD88" />
                <stop offset="85%" stop-color="#C6A15B" />
                <stop offset="100%" stop-color="#9A7738" />
              </linearGradient>

              <linearGradient id="satinGoldShadow" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#E5D1AD" />
                <stop offset="45%" stop-color="#C6A15B" />
                <stop offset="80%" stop-color="#A27D3B" />
                <stop offset="100%" stop-color="#6A4E20" />
              </linearGradient>

              <linearGradient id="knotGlow" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#C6A15B" />
                <stop offset="35%" stop-color="#FFF9ED" />
                <stop offset="65%" stop-color="#D8BD88" />
                <stop offset="100%" stop-color="#8F6E2E" />
              </linearGradient>

              <filter id="bowFabricShadow" x="-25%" y="-25%" width="150%" height="150%">
                <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#3E1424" flood-opacity="0.45" />
              </filter>
            </defs>

            <!-- Cascading Ribbon Tails -->
            <g id="bow-tail-left-grp" class="bow-anim-tail-left" filter="url(#bowFabricShadow)">
              <path d="M110,115 C90,145 65,180 46,210 C57,200 68,198 78,206 C96,178 110,146 122,118 Z" fill="url(#satinGoldShadow)" />
              <path d="M110,115 C92,143 70,175 52,204 C55,200 60,199 66,202 C82,176 98,146 114,120 Z" fill="url(#satinGoldSheen)" opacity="0.65" />
            </g>

            <g id="bow-tail-right-grp" class="bow-anim-tail-right" filter="url(#bowFabricShadow)">
              <path d="M130,115 C150,145 175,180 194,210 C183,200 172,198 162,206 C144,178 130,146 118,118 Z" fill="url(#satinGoldShadow)" />
              <path d="M130,115 C148,143 170,175 188,204 C185,200 180,199 174,202 C158,176 142,146 126,120 Z" fill="url(#satinGoldSheen)" opacity="0.65" />
            </g>

            <!-- Left Satin Loop -->
            <g id="bow-loop-left-grp" class="bow-anim-loop-left" filter="url(#bowFabricShadow)">
              <path d="M120,105 C90,50 32,54 26,86 C20,116 78,118 114,108 Z" fill="url(#satinGoldSheen)" />
              <path d="M42,84 C48,68 80,68 104,96 C84,96 58,94 42,84 Z" fill="url(#satinGoldShadow)" opacity="0.55" />
            </g>

            <!-- Right Satin Loop -->
            <g id="bow-loop-right-grp" class="bow-anim-loop-right" filter="url(#bowFabricShadow)">
              <path d="M120,105 C150,50 208,54 214,86 C220,116 162,118 126,108 Z" fill="url(#satinGoldSheen)" />
              <path d="M198,84 C192,68 160,68 136,96 C156,96 182,94 198,84 Z" fill="url(#satinGoldShadow)" opacity="0.55" />
            </g>

            <!-- Central Tied Knot -->
            <g id="bow-knot-grp" class="bow-anim-knot" filter="url(#bowFabricShadow)">
              <rect x="100" y="86" width="40" height="42" rx="12" fill="url(#knotGlow)" stroke="#FFFDF8" stroke-width="1.2" />
              <path d="M106,93 C114,106 114,111 106,120" stroke="#8F6E2E" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7" />
              <path d="M134,93 C126,106 126,111 134,120" stroke="#8F6E2E" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7" />
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- Luxury "TAP TO OPEN" Button Overlay -->
    <div class="tap-to-open-container">
      <button 
        id="tap-to-open-btn" 
        class="tap-to-open-button luxury-burgundy-btn" 
        type="button" 
        aria-label="Tap to open the wedding invitation"
      >
        <span class="tap-sparkle">✦</span>
        <span class="tap-text">TAP TO OPEN</span>
        <span class="tap-sparkle">✦</span>
      </button>
    </div>
  </div>
</aside>
---
interface Props {
  brideName: string;
  groomName: string;
  welcomeMessage: string;
  formattedDate: string;
  destination: string;
}

const { brideName, groomName, welcomeMessage, formattedDate, destination } = Astro.props;
---

<section id="invitation-cover" class="hero-section-fullbleed">
  <!-- Full Coastal Watercolor Background Spanning 100% of Viewport -->
  <div class="hero-bg-backdrop" aria-hidden="true">
    <img 
      src="/jony-wedding/assets/backgrounds/coastal-castle-scene.jpg" 
      alt="Mediterranean Coastal Castle" 
      class="hero-fullbleed-bg"
    />
    <div class="hero-scenic-overlay"></div>
  </div>

  <!-- Decorative Corner & Side Florals for Desktop Landscape Balance -->
  <div class="hero-botanical-decorations" aria-hidden="true">
    <img 
      src="/jony-wedding/assets/decorations/floral-top-border.jpg" 
      alt="" 
      class="hero-botanical-top floating-botanical"
    />
    <div class="hero-side-botanical hero-side-botanical-left">
      <img src="/jony-wedding/assets/decorations/floral-top-border.jpg" alt="" />
    </div>
    <div class="hero-side-botanical hero-side-botanical-right">
      <img src="/jony-wedding/assets/decorations/floral-top-border.jpg" alt="" />
    </div>
  </div>

  <!-- Separate Foreground Content Layer -->
  <div class="hero-foreground-content">
    <div class="hero-card-panel">
      <!-- Monogram Crest -->
      <div class="hero-crest-badge">
        <span class="hero-monogram">J & S</span>
      </div>

      <!-- Welcome Message -->
      <p class="hero-intro-lead cover-intro-lead">{welcomeMessage}</p>

      <!-- Couple Names Display -->
      <div class="hero-couple-names cover-couple-names">
        <h1 class="hero-bride-name cover-bride-name">{brideName}</h1>
        <span class="hero-ampersand cover-ampersand">&</span>
        <h1 class="hero-groom-name cover-groom-name">{groomName}</h1>
      </div>

      <div class="botanical-divider">
        <span class="botanical-divider-icon">❦</span>
      </div>

      <!-- Date & Venue -->
      <div class="hero-date-banner cover-date-banner">
        <p class="hero-wedding-date cover-wedding-date">{formattedDate}</p>
        <p class="hero-wedding-venue cover-wedding-venue">{destination}</p>
      </div>

      <!-- Scroll Indicator -->
      <div class="hero-scroll-cue" aria-hidden="true">
        <span class="hero-scroll-text">✦ Scroll to Discover ✦</span>
        <span class="hero-scroll-arrow">↓</span>
      </div>
    </div>
  </div>
</section>
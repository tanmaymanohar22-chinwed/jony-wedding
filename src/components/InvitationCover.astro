---
interface Props {
  brideName: string;
  groomName: string;
  welcomeMessage: string;
  formattedDate: string;
  destination: string;
}

const { brideName, groomName, welcomeMessage, formattedDate, destination } = Astro.props;
---

<section id="invitation-cover" class="invitation-page-fullbleed">
  <!-- Perimeter Luxury Double Border Inset -->
  <div class="invitation-page-border" aria-hidden="true">
    <div class="invitation-page-inner-border"></div>
  </div>

  <!-- 4 Corner Luxury Botanical Ornaments -->
  <div class="invitation-corner-ornaments" aria-hidden="true">
    <span class="corner-ornament corner-top-left">❦</span>
    <span class="corner-ornament corner-top-right">❦</span>
    <span class="corner-ornament corner-bottom-left">❦</span>
    <span class="corner-ornament corner-bottom-right">❦</span>
  </div>

  <!-- Invitation Main Body Covering the Full Viewport -->
  <div class="invitation-full-container">
    <!-- Top Watercolor Botanical Garland -->
    <div class="invitation-top-garland" aria-hidden="true">
      <img 
        src="/jony-wedding/assets/decorations/floral-top-border.jpg" 
        alt="" 
        class="invitation-floral-header floating-botanical"
      />
    </div>

    <!-- Sacred Monogram Emblem -->
    <div class="invitation-crest-emblem">
      <span class="invitation-monogram">J & S</span>
    </div>

    <!-- Invitation Heading / Welcome Message -->
    <p class="invitation-lead-text cover-intro-lead">{welcomeMessage}</p>

    <!-- Couple Names Display -->
    <div class="invitation-couple-block cover-couple-names">
      <h1 class="invitation-bride-name cover-bride-name">{brideName}</h1>
      <span class="invitation-ampersand cover-ampersand">&</span>
      <h1 class="invitation-groom-name cover-groom-name">{groomName}</h1>
    </div>

    <div class="botanical-divider" style="margin: clamp(10px, 2vh, 18px) auto;">
      <span class="botanical-divider-icon">❦</span>
    </div>

    <!-- Sacred Blessing / Invitation Note -->
    <p class="invitation-sub-lead">
      We joyfully request the honour of your presence to witness our sacred vows and celebrate our love
    </p>

    <!-- Scroll Cue Pointing directly to Scratch to Reveal Section -->
    <div class="invitation-scroll-prompt" aria-hidden="true">
      <span class="invitation-scroll-sparkle">✦</span>
      <span class="invitation-scroll-label">Scratch below to reveal date & venue</span>
      <span class="invitation-scroll-arrow">↓</span>
    </div>
  </div>
</section>
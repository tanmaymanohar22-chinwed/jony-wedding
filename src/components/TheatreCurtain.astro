---
// Theatre Curtain Reveal Component (Layer 2: Positioned directly behind paper doors)
---

<div id="theatre-curtain-overlay" class="curtain-overlay" data-state="closed" aria-hidden="true">
  <!-- 3D Perspective Stage Container -->
  <div class="curtain-stage-scene">
    <!-- Upper Decorative Valance & Curved Swags with Gold Trim -->
    <header class="curtain-valance-arch">
      <div class="curtain-swag curtain-swag-left"></div>
      <div class="curtain-swag curtain-swag-center"></div>
      <div class="curtain-swag curtain-swag-right"></div>
      <div class="curtain-gold-fringe">
        <svg viewBox="0 0 1200 40" preserveAspectRatio="none" class="gold-fringe-svg">
          <path d="M0,0 L1200,0 L1200,10 Q1100,35 1000,10 Q900,35 800,10 Q700,35 600,10 Q500,35 400,10 Q300,35 200,10 Q100,35 0,10 Z" fill="url(#goldTrimGrad)" />
          <defs>
            <linearGradient id="goldTrimGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#D4AF37" />
              <stop offset="25%" stop-color="#FFF2A3" />
              <stop offset="50%" stop-color="#C59B27" />
              <stop offset="75%" stop-color="#FFF8D1" />
              <stop offset="100%" stop-color="#AA7C11" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="curtain-valance-tassels">
        <span class="curtain-tassel">✦</span>
        <span class="curtain-tassel">❦</span>
        <span class="curtain-tassel">✦</span>
        <span class="curtain-tassel">❦</span>
        <span class="curtain-tassel">✦</span>
      </div>
    </header>

    <!-- Main Parting Draped Curtains (Left & Right) -->
    <div class="curtain-track-rig">
      <!-- Left Draped Curtain Panel -->
      <div class="curtain-panel curtain-panel-left">
        <div class="curtain-fabric-pleats">
          <div class="pleat p1"></div>
          <div class="pleat p2"></div>
          <div class="pleat p3"></div>
          <div class="pleat p4"></div>
          <div class="pleat p5"></div>
          <div class="pleat p6"></div>
          <div class="pleat p7"></div>
        </div>
        <div class="curtain-sash curtain-sash-left"></div>
        <div class="curtain-lead-edge-glow"></div>
      </div>

      <!-- Right Draped Curtain Panel -->
      <div class="curtain-panel curtain-panel-right">
        <div class="curtain-fabric-pleats">
          <div class="pleat p7"></div>
          <div class="pleat p6"></div>
          <div class="pleat p5"></div>
          <div class="pleat p4"></div>
          <div class="pleat p3"></div>
          <div class="pleat p2"></div>
          <div class="pleat p1"></div>
        </div>
        <div class="curtain-sash curtain-sash-right"></div>
        <div class="curtain-lead-edge-glow"></div>
      </div>
    </div>

    <!-- Lower Corner Botanical Arrangements -->
    <footer class="curtain-stage-footer">
      <div class="curtain-floral-corner curtain-floral-left">
        <img 
          src="/jony-wedding/assets/decorations/floral-top-border.png" 
          alt="" 
          class="curtain-corner-img"
        />
      </div>
      <div class="curtain-floral-corner curtain-floral-right">
        <img 
          src="/jony-wedding/assets/decorations/floral-top-border.png" 
          alt="" 
          class="curtain-corner-img"
        />
      </div>
    </footer>
  </div>
</div>
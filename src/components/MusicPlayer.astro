---
interface MusicData {
  title: string;
  src: string;
}

interface Props {
  music: MusicData;
}

const { music } = Astro.props;
---

<div id="music-player-wrapper" class="music-floating-wrapper">
  <button id="music-toggle" class="music-toggle-btn spin-slow spin-paused" aria-label="Toggle background music" title={music.title}>
    <!-- Music Playing Icon (Waves/Disc) -->
    <svg id="music-icon-playing" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B88E44" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
      <path d="M9 18V5l12-2v13"></path>
      <circle cx="6" cy="18" r="3"></circle>
      <circle cx="18" cy="16" r="3"></circle>
    </svg>

    <!-- Music Muted Icon -->
    <svg id="music-icon-muted" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6E655F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <line x1="23" y1="9" x2="17" y2="15"></line>
      <line x1="17" y1="9" x2="23" y2="15"></line>
    </svg>
  </button>
</div>

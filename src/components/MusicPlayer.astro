---
interface MusicData {
  title: string;
  src: string;
}

interface Props {
  music: MusicData;
}

const { music } = Astro.props;
---

<div id="music-player-fixed" class="music-player-fixed">
  <button 
    id="music-toggle-btn" 
    class="music-circle-control spin-slow spin-paused" 
    aria-label="Toggle background music" 
    title={music.title}
  >
    <!-- Playing State (Stylized Vinyl / Notes) -->
    <svg id="music-icon-playing" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C7A77B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
      <circle cx="12" cy="12" r="10"></circle>
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M12 2a10 10 0 0 0-4 1"></path>
    </svg>

    <!-- Muted / Paused State -->
    <svg id="music-icon-muted" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7A7068" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <line x1="23" y1="9" x2="17" y2="15"></line>
      <line x1="17" y1="9" x2="23" y2="15"></line>
    </svg>
  </button>
</div>
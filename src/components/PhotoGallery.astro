---
interface PhotoItem {
  url: string;
  title: string;
  caption: string;
}

interface Props {
  gallery: PhotoItem[];
}

const { gallery } = Astro.props;
---

<section id="photo-gallery" class="invite-section reveal-on-scroll">
  <div class="section-heading-block">
    <span class="section-label">MEMORIES & SMILES</span>
    <h2 class="section-title">Cherished Moments</h2>
    <p class="section-desc">A glimpse into our journey together along the coastline</p>
  </div>

  <div class="botanical-divider" style="margin-bottom: 24px;">
    <span class="botanical-divider-icon">❦</span>
  </div>

  <div class="gallery-grid">
    {gallery.map((photo, index) => (
      <div 
        class="gallery-card" 
        data-index={index} 
        data-src={photo.url} 
        data-title={photo.title} 
        data-caption={photo.caption}
      >
        <img 
          src={photo.url} 
          alt={photo.title} 
          loading="lazy" 
        />
        <div class="gallery-caption-bar">
          <p>{photo.title}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Interactive Lightbox Modal -->
  <div id="gallery-lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Photo Preview" aria-hidden="true">
    <button id="lightbox-close" class="lightbox-close-btn" aria-label="Close preview (Esc)">✕</button>

    <button id="lightbox-prev" class="lightbox-nav-btn lightbox-prev-btn" aria-label="Previous photo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button id="lightbox-next" class="lightbox-nav-btn lightbox-next-btn" aria-label="Next photo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    
    <div class="lightbox-img-box">
      <img id="lightbox-preview-img" src="" alt="Enlarged photo preview" />
      <div style="text-align: center;">
        <span id="lightbox-counter" class="lightbox-counter font-sans" style="color: var(--color-champagne); font-size: 0.78rem; letter-spacing: 0.15em; display: block; margin-bottom: 4px;"></span>
        <h4 id="lightbox-preview-title" class="font-serif" style="color: #FFFDF8; font-size: 1.25rem; margin: 0 0 4px;"></h4>
        <p id="lightbox-preview-caption" class="font-serif-sub" style="color: var(--color-champagne-light); font-size: 0.95rem; font-style: italic; margin: 0;"></p>
      </div>
    </div>
  </div>
</section>
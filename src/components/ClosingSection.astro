---
interface ClosingData {
  message: string;
  signature: string;
  hosts: string;
}

interface Props {
  closing: ClosingData;
  monogram: string;
}

const { closing, monogram } = Astro.props;
---

<section id="closing-section" class="invite-section reveal-on-scroll">
  <div class="closing-card paper-card">
    <div class="closing-icon font-script text-gold">{monogram}</div>
    
    <p class="closing-message font-serif">{closing.message}</p>
    
    <div class="gold-divider">
      <span class="gold-divider-icon">❦</span>
    </div>

    <p class="closing-signature font-script text-rose">{closing.signature}</p>
    <p class="closing-hosts font-sans text-charcoal">{closing.hosts}</p>
  </div>
</section>

<style>
  .closing-card {
    padding: 48px 24px;
    text-align: center;
  }

  .closing-icon {
    font-size: 3.2rem;
    line-height: 1;
    margin-bottom: 20px;
  }

  .closing-message {
    font-size: 1.25rem;
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto;
    color: var(--color-charcoal);
  }

  .closing-signature {
    font-size: 2.2rem;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .closing-hosts {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-muted);
  }
</style>

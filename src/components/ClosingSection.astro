---
interface ClosingData {
  heading: string;
  message: string;
  signature: string;
  hosts: string;
}

interface Props {
  closing: ClosingData;
  monogram: string;
}

const { closing, monogram } = Astro.props;
---

<section id="closing-section" class="invite-section reveal-on-scroll" style="padding-bottom: 30px;">
  <div class="closing-landscape-wrapper">
    <!-- Scenic Garden Fountain Watercolor Illustration -->
    <img 
      src="/jony-wedding/assets/backgrounds/garden-fountain-closing.jpg" 
      alt="Scenic Garden Fountain" 
      class="closing-garden-art"
    />

    <!-- Layered Romantic Forest-Green Gradient Overlay -->
    <div class="closing-card-overlay">
      <span class="font-script" style="font-size: 2.8rem; color: var(--color-champagne-light); line-height: 1; margin-bottom: 8px;">
        {monogram}
      </span>

      <h2 class="closing-heading">{closing.heading}</h2>

      <div class="botanical-divider" style="max-width: 160px; margin: 4px auto 16px;">
        <span class="botanical-divider-icon" style="color: var(--color-champagne-light);">❦</span>
      </div>

      <p class="closing-message-text">{closing.message}</p>

      <p class="closing-signature-text">{closing.signature}</p>
      <p class="closing-family-hosts">{closing.hosts}</p>
    </div>
  </div>
</section>
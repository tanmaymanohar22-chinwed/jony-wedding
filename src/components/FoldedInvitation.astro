---
interface Props {
  monogram?: string;
}

const { monogram = "J & S" } = Astro.props;
---

<div id="invitation-opening-stage" class="folded-stage-wrapper" data-state="closed">
  <!-- 3D Perspective Card Scene -->
  <div class="folded-card-scene">
    <!-- Physical Folded Stationery Folio Container -->
    <div id="physical-folded-card" class="physical-folded-card">
      
      <!-- Gatefold Paper Folio Panels (Left and Right meeting in center) -->
      <div class="folio-paper-structure">
        <!-- Left Folio Panel -->
        <div class="folio-panel folio-panel-left">
          <div class="folio-panel-surface">
            <div class="folio-crease-shadow"></div>
            <div class="folio-deckle-edge"></div>
          </div>
        </div>

        <!-- Right Folio Panel -->
        <div class="folio-panel folio-panel-right">
          <div class="folio-panel-surface">
            <div class="folio-crease-shadow"></div>
            <div class="folio-deckle-edge"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
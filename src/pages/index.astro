---
import InvitationLayout from '../layouts/InvitationLayout.astro';
import IntroOverlay from '../components/IntroOverlay.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import InvitationCover from '../components/InvitationCover.astro';
import ScratchToReveal from '../components/ScratchToReveal.astro';
import Countdown from '../components/Countdown.astro';
import EventSchedule from '../components/EventSchedule.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import ClosingSection from '../components/ClosingSection.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import weddingData from '../data/wedding.json';

const pageTitle = `${weddingData.couple.bride.firstName} & ${weddingData.couple.groom.firstName} — Luxury Wedding Invitation`;
const pageDescription = `Join us in celebrating the wedding of ${weddingData.couple.bride.fullName} and ${weddingData.couple.groom.fullName} on ${weddingData.formattedDate}.`;
---

<InvitationLayout title={pageTitle} description={pageDescription}>
  <!-- 1. FULL-SCREEN DEDICATED INTRO OVERLAY (Edge-to-edge watercolor & folded paper) -->
  <IntroOverlay
    monogram={weddingData.monogram}
    brideName={weddingData.couple.bride.fullName}
    groomName={weddingData.couple.groom.fullName}
    welcomeMessage={weddingData.welcomeMessage}
    formattedDate={weddingData.formattedDate}
    destination={weddingData.destination}
  />

  <!-- 2. MAIN WEDDING WEBSITE (Live HTML website revealed directly behind opening paper doors) -->
  <main id="wedding-site" class="wedding-site" inert aria-hidden="true">
    <LanguageSwitcher languages={weddingData.languages} />

    <div class="invitation-shell">
      <!-- Section 1: Main Wedding Invitation Hero -->
      <InvitationCover
        brideName={weddingData.couple.bride.fullName}
        groomName={weddingData.couple.groom.fullName}
        welcomeMessage={weddingData.welcomeMessage}
        formattedDate={weddingData.formattedDate}
        destination={weddingData.destination}
      />

      <!-- Section 2: Heart-Shaped Scratch to Reveal Wedding Date & Save-the-Date -->
      <ScratchToReveal
        weddingDate={weddingData.weddingDate}
        formattedDate={weddingData.formattedDate}
        venue={weddingData.venue}
        address={weddingData.address}
      />

      <!-- Section 3: Live Wedding Countdown (Activated ONLY after scratch reveal) -->
      <Countdown weddingDate={weddingData.weddingDate} />

      <!-- Section 4: Confirmed Ceremony & Reception Event Details -->
      <EventSchedule events={weddingData.events} />

      <!-- Section 5: Editorial Photo Gallery -->
      <PhotoGallery gallery={weddingData.gallery} />

      <!-- Section 7: Scenic Closing Garden Illustration -->
      <ClosingSection closing={weddingData.closing} monogram={weddingData.monogram} />
    </div>

    <!-- Section 8: Bottom-Center Floating Music Player -->
    <MusicPlayer music={weddingData.music} />
  </main>
</InvitationLayout>

<script>
  import { initFoldedOpening } from '../scripts/folded-opening';
  import { initScratchCard } from '../scripts/scratch-card';
  import { setupCountdownListener } from '../scripts/countdown';
  import { initMusic } from '../scripts/music';
  import { initGallery, initScrollReveal } from '../scripts/gallery';
  import weddingData from '../data/wedding.json';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initialize Background Music Player
    const musicController = initMusic(weddingData.music.src);

    // 2. Initialize Single-Tap Entrance Sequence (Paper Doors -> Live Site)
    initFoldedOpening(() => {
      musicController.play();
    });

    // 3. Initialize Interactive Scratch-to-Reveal Card
    initScratchCard();

    // 4. Setup Event Listener for Wedding Countdown (Activates only on date reveal)
    setupCountdownListener(weddingData.weddingDate);

    // 5. Initialize Photo Gallery Lightbox and Scroll Reveal
    initGallery();
    initScrollReveal();
  });
</script>